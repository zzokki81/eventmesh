# =========================
# APPLICATION ENV EXAMPLE
# =========================


# =========================
# HTTP SERVER CONFIG
# =========================

# HTTP server listen address (host:port). Empty host binds all interfaces.
# Optional | format: hostname_port | default: :8080
HTTP_ADDR=

# Maximum duration for reading the entire request (headers + body).
# Optional | min: 1s | default: 10s
HTTP_READ_TIMEOUT=

# Maximum duration before timing out writes of the response.
# Optional | min: 1s | default: 10s
HTTP_WRITE_TIMEOUT=

# Maximum time to wait for the next request when keep-alives are enabled.
# Optional | min: 1s | default: 120s
HTTP_IDLE_TIMEOUT=

# Maximum duration to wait for graceful shutdown before forcing exit.
# Optional | min: 1s | default: 15s
HTTP_SHUTDOWN_TIMEOUT=

# Maximum time to wait for reading request headers.
# Optional | min: 1s | default: 5s
HTTP_READ_HEADER_TIMEOUT=


# =========================
# NATS CONFIG
# =========================

# Connection string for the NATS server.
# Required | format: url | no default
NATS_URL=

# JetStream stream name used by the application.
# Optional | min: 1 | max: 255 | default: EVENTMESH
NATS_STREAM_NAME=

# Durable consumer name for JetStream subscription.
# Optional | min: 1 | max: 255 | default: eventmesh-worker
NATS_CONSUMER_NAME=

# Duration to wait before attempting to reconnect after a disconnection.
# Optional | min: 100ms | default: 2s
NATS_RECONNECT_WAIT=

# Maximum number of reconnection attempts before giving up. -1 = retry forever.
# Optional | min: -1 | default: -1
NATS_MAX_RECONNECTS=

# Duration the server waits for an ACK before redelivering the message.
# Optional | min: 1s | default: 30s
NATS_ACK_WAIT=

# Maximum delivery attempts before a message is considered undeliverable.
# Optional | min: 1 | max: 100 | default: 5
NATS_MAX_DELIVER=

# Duration between ping messages to the NATS server.
# Optional | min: 1s | default: 10s
NATS_PING_INTERVAL=

# Maximum outstanding ping messages before connection is considered lost.
# Optional | min: 1 | max: 10 | default: 3
NATS_MAX_PINGS_OUT=

# Duration to wait for the initial connection to NATS to be established.
# Optional | min: 1s | default: 5s
NATS_CONNECT_TIMEOUT=


# =========================
# POSTGRES CONFIG
# =========================
# PostgreSQL connection string (DSN), including credentials and host.
# Required | format: url | no default
DATABASE_URL=

# Maximum number of connections the pool can hold at once.
# Optional | min: 1 | max: 500 | default: 25
DB_MAX_CONNS=

# Minimum number of connections the pool keeps open even when idle. Must be <= DB_MAX_CONNS.
# Optional | min: 0 | default: 5
DB_MIN_CONNS=

# Maximum time a connection may sit idle in the pool before being closed.
# Optional | min: 1s | default: 5m
DB_CONN_MAX_IDLE_TIME=

# Maximum total lifetime of a connection before it is closed and recycled.
# Optional | min: 1s | default: 5m
DB_CONN_MAX_LIFETIME=

# Timeout for a single database query.
# Optional | min: 100ms | default: 3s
DB_QUERY_TIMEOUT=

# =========================
# REDIS CONFIG
# =========================

# Redis server address in host:port format.
# Required | format: hostname_port | no default
REDIS_ADDR=

# Password used for Redis AUTH. Leave empty if Redis has no password.
# Optional | min (when set): 8 | no default
REDIS_PASSWORD=

# Redis logical database index to select after connecting.
# Optional | min: 0 | max: 15 | default: 0
REDIS_DB=

# Maximum number of connections in the pool.
# Optional | min: 1 | max: 1000 | default: 10
REDIS_POOL_SIZE=

# Minimum number of idle connections kept in the pool. Must be <= REDIS_POOL_SIZE.
# Optional | min: 0 | default: 5
REDIS_MIN_IDLE_CONNS=

# Timeout for establishing new connections to Redis.
# Optional | min: 1s | default: 3s
REDIS_DIAL_TIMEOUT=

# Timeout for socket reads.
# Optional | min: 100ms | default: 1s
REDIS_READ_TIMEOUT=

# Timeout for socket writes.
# Optional | min: 100ms | default: 1s
REDIS_WRITE_TIMEOUT=

# Maximum time to wait for a free connection from the pool.
# Optional | min: 1s | default: 4s
REDIS_POOL_TIMEOUT=


# =========================
# RELAY CONFIG
# =========================

# Number of pending outbox events fetched and processed per cycle.
# Optional | min: 1 | max: 500 | default: 100
RELAY_BATCH_SIZE=

# How often the relay polls the outbox for pending events.
# Optional | min: 50ms | default: 500ms
RELAY_TICK_INTERVAL=

# Publish attempts before an event is marked dead.
# Optional | min: 1 | max: 100 | default: 5
RELAY_MAX_ATTEMPTS=


# =========================
# LOGGER CONFIG
# =========================

# Minimum log severity that will be written.
# Optional | allowed: debug, info, warn, error | default: info
LOG_LEVEL=

# Log output serialization format.
# Optional | allowed: json, text, pretty | default: json
LOG_FORMAT=

# Destination stream for log output.
# Optional | allowed: stdout, stderr | default: stdout
LOG_OUTPUT=

# Include source file and line information in each log record.
# Optional | allowed: true, false | default: false
LOG_ADD_SOURCE=
